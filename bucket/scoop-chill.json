{
    "version": "0.0.4",
    "description": "Update apps only once their manifest has aged",
    "homepage": "https://github.com/kroteau/scoop-chill",
    "license": "MIT",
    "url": "https://github.com/kroteau/scoop-chill/archive/refs/tags/v0.0.4.zip",
    "hash": "1af9670c94ba3290f05c8aaf3e4018170ff7ff8f633d94641a2e2ac4373dbd35",
    "extract_dir": "scoop-chill-0.0.4",
    "suggest": {
        "Git (required to read bucket history)": [
            "git",
            "git-with-openssh"
        ]
    },
    "post_install": [
        "# Install raw command files because Scoop resolves generated PowerShell shims",
        "# from its lib directory instead of the app directory for scoop subcommands.",
        "Copy-Item \"$dir\\scoop-chill.ps1\", \"$dir\\chill-lib.ps1\" (shimdir $false) -Force"
    ],
    "post_uninstall": [
        "# Scoop also runs post_uninstall during updates. Only scoop-uninstall.ps1",
        "# defines $appDir, so remove the command and state only on actual uninstall.",
        "if ($null -ne $appDir) {",
        "    Remove-Item (Join-Path (shimdir $false) 'scoop-chill.ps1'), (Join-Path (shimdir $false) 'chill-lib.ps1') -Force -ErrorAction SilentlyContinue",
        "    Remove-Item \"$scoopdir\\persist\\scoop-chill\" -Recurse -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/kroteau/scoop-chill/archive/refs/tags/v$version.zip",
        "extract_dir": "scoop-chill-$version"
    }
}
